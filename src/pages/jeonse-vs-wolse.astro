---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const faqItems = [
  {
    q: '전세는 보증금을 돌려받는데 왜 기회비용을 계산해야 하나요?',
    a: '보증금으로 묶여 있는 내 현금(자기자본)을 예금·채권·ETF 등에 굴렸을 때 얻을 수 있었던 수익을 포기하는 것이기 때문입니다. 예를 들어 1억 원이 보증금으로 묶여 있으면 연 3.5% 예금 기준으로 매달 약 29만 원의 이자 수익을 포기하는 셈입니다.',
  },
  {
    q: '손익분기 월세란 무엇인가요?',
    a: '전세와 월세의 실질 월 주거비가 정확히 같아지는 월세 금액입니다. 실제 계약하려는 월세가 손익분기 월세보다 낮으면 월세가 유리하고, 높으면 전세가 유리합니다.',
  },
  {
    q: '전세 보증보험료나 복비(중개보수)도 고려해야 하나요?',
    a: '네, 전세는 보증금이 커서 중개보수와 전세보증금 반환보증 보험료가 월세보다 더 많이 나오는 편입니다. 전세와 월세의 실질 비용 차이가 월 5~10만 원 이내로 근소하다면 보증보험료·리스크를 감안해 월세가 더 안전할 수 있습니다.',
  },
  {
    q: '월세 세액공제 혜택은 어떻게 반영하나요?',
    a: '총급여 8,000만 원 이하 무주택 세대주 등은 연간 월세 납입액의 15~17%(한도 1,000만 원)를 연말정산에서 세액공제 받을 수 있습니다. 대상자라면 월세 금액에서 약 15%를 낮춰 입력해 비교해보면 더욱 정확합니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '전세 vs 월세 진짜 손익 비교기',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="전세 vs 월세 진짜 손익 비교기 (대출이자·기회비용 포함)"
  description="전세대출 이자, 보유 현금의 예금·투자 기회비용, 관리비까지 원 단위로 모두 반영해 전세와 월세 중 어느 쪽이 유리한지와 손익분기 월세를 계산합니다."
  canonicalPath="/jeonse-vs-wolse/"
  breadcrumbCategory="주거 · 전월세"
  jsonLd={jsonLd}
>
  <div class="calc-header">
    <nav class="breadcrumb" aria-label="경로">
      <a href="/">얼마야</a>
      <span>/</span>
      <span>주거 · 전월세</span>
    </nav>
    <h1>전세 vs 월세 진짜 손익 비교기</h1>
    <p class="page-lead">
      단순 월세 금액이 아니라 전세대출 이자와 내 돈의 기회비용(예금·투자 수익률)까지 원 단위로 반영해 진짜 유리한 선택을 계산합니다.
    </p>
  </div>

  <div class="calc-grid">
    <!-- Input Panel -->
    <section class="panel" aria-label="입력 조건">
      <div class="panel-title">
        <span>공통 · 계약 조건 입력</span>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field-label" for="my-cash">
            <span>보유 현금</span>
            <span class="field-hint num" id="my-cash-kor">1억원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="my-cash" class="input-text has-unit num" value="100,000,000" />
            <span class="input-unit">원</span>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="stay-years">
            <span>거주 예정 기간</span>
          </label>
          <div class="input-wrap">
            <input type="number" id="stay-years" class="input-text has-unit num" value="2" min="1" max="10" step="1" />
            <span class="input-unit">년</span>
          </div>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="opp-rate">
          <span>여유자금 연 기대수익률 (기회비용)</span>
          <span class="field-hint">예금·채권·ETF 연 수익률</span>
        </label>
        <div class="input-wrap">
          <input type="number" id="opp-rate" class="input-text has-unit num" value="3.5" min="0" max="20" step="0.1" />
          <span class="input-unit">%</span>
        </div>
        <div class="preset-row">
          <button type="button" class="preset-btn" data-target="opp-rate" data-val="0">고려안함 0%</button>
          <button type="button" class="preset-btn" data-target="opp-rate" data-val="3.5">예금 3.5%</button>
          <button type="button" class="preset-btn" data-target="opp-rate" data-val="5.0">채권/배당 5%</button>
          <button type="button" class="preset-btn" data-target="opp-rate" data-val="7.0">투자 7%</button>
        </div>
      </div>

      <hr style="border: none; border-top: 1px solid var(--border); margin: 20px 0;" />

      <p class="form-section-title">A. 전세 조건</p>
      <div class="field-row">
        <div class="field">
          <label class="field-label" for="j-deposit">
            <span>전세 보증금</span>
            <span class="field-hint num" id="j-deposit-kor">3억원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="j-deposit" class="input-text has-unit num" value="300,000,000" />
            <span class="input-unit">원</span>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="j-loan-rate"><span>전세대출 금리 (연)</span></label>
          <div class="input-wrap">
            <input type="number" id="j-loan-rate" class="input-text has-unit num" value="3.8" min="0" max="15" step="0.1" />
            <span class="input-unit">%</span>
          </div>
        </div>
      </div>
      <div class="field">
        <label class="field-label" for="j-maint">
          <span>전세 월 관리비</span>
          <span class="field-hint num" id="j-maint-kor">15만원</span>
        </label>
        <div class="input-wrap">
          <input type="text" inputmode="numeric" autocomplete="off" id="j-maint" class="input-text has-unit num" value="150,000" />
          <span class="input-unit">원</span>
        </div>
      </div>

      <hr style="border: none; border-top: 1px solid var(--border); margin: 20px 0;" />

      <p class="form-section-title" style="color: var(--warning);">B. 월세 조건</p>
      <div class="field-row">
        <div class="field">
          <label class="field-label" for="w-deposit">
            <span>월세 보증금</span>
            <span class="field-hint num" id="w-deposit-kor">3,000만원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="w-deposit" class="input-text has-unit num" value="30,000,000" />
            <span class="input-unit">원</span>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="w-rent">
            <span>월세 금액</span>
            <span class="field-hint num" id="w-rent-kor">100만원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="w-rent" class="input-text has-unit num" value="1,000,000" />
            <span class="input-unit">원</span>
          </div>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label class="field-label" for="w-loan-rate"><span>보증금 대출금리 (필요시)</span></label>
          <div class="input-wrap">
            <input type="number" id="w-loan-rate" class="input-text has-unit num" value="4.5" min="0" max="15" step="0.1" />
            <span class="input-unit">%</span>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="w-maint">
            <span>월세 월 관리비</span>
            <span class="field-hint num" id="w-maint-kor">15만원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="w-maint" class="input-text has-unit num" value="150,000" />
            <span class="input-unit">원</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Result Panel -->
    <section class="panel panel-result" aria-live="polite" aria-label="비교 결과">
      <div class="panel-title">
        <span>실질 주거비 비교 결과</span>
      </div>

      <div class="result-summary" id="jw-box">
        <div class="result-label" id="jw-verdict-label">전세가 더 유리합니다</div>
        <div class="result-figure num" id="jw-verdict-figure">월 0원 절약</div>
        <div class="result-sub" id="jw-verdict-sub">2년 거주 기준 총 0원 차이가 발생합니다.</div>
      </div>

      <table class="ledger">
        <thead>
          <tr style="border-bottom: 2px solid var(--border);">
            <th>비교 항목 (월 기준)</th>
            <th style="text-align: right;">전세</th>
            <th style="text-align: right;">월세</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>필요 대출금</th>
            <td id="j-loan">0원</td>
            <td id="w-loan">0원</td>
          </tr>
          <tr>
            <th>월 대출이자</th>
            <td id="j-interest">0원</td>
            <td id="w-interest">0원</td>
          </tr>
          <tr>
            <th>월세 납부액</th>
            <td>0원</td>
            <td id="w-rent-out">0원</td>
          </tr>
          <tr>
            <th>보증금 기회비용</th>
            <td id="j-opp">0원</td>
            <td id="w-opp">0원</td>
          </tr>
          <tr>
            <th>월 관리비</th>
            <td id="j-maint-out">0원</td>
            <td id="w-maint-out">0원</td>
          </tr>
          <tr class="total-row">
            <th>월 실질 주거비</th>
            <td id="j-monthly">0원</td>
            <td id="w-monthly">0원</td>
          </tr>
          <tr>
            <th>총 기간 실질 비용 (<span id="stay-label">2년</span>)</th>
            <td id="j-total">0원</td>
            <td id="w-total">0원</td>
          </tr>
        </tbody>
      </table>

      <div class="disclaimer-box" style="margin-top: 16px; background: var(--surface-tint); border-color: #cce7e4; color: var(--brand-ink);">
        <strong>손익분기 월세:</strong> <span class="num" id="breakeven-rent" style="font-weight: 800;">0원</span><br />
        <span style="font-size: 0.82rem; color: var(--ink-secondary);">
          현재 조건에서 월세가 이 금액 이하라면 <strong>월세가 유리</strong>, 초과하면 <strong>전세가 유리</strong>합니다.
        </span>
      </div>

      <div class="action-row">
        <button type="button" class="btn-secondary" id="jw-copy">결과 복사</button>
        <button type="button" class="btn-secondary" id="jw-share">링크 공유</button>
        <button type="button" class="btn-secondary" id="jw-reset">초기화</button>
      </div>
    </section>
  </div>

  <!-- Editorial SEO Guide & FAQ -->
  <article class="guide-section">
    <h2>전세 vs 월세, '진짜 비용'을 비교하는 방법</h2>
    <p>
      많은 사람들이 "전세는 이자만 내고 보증금을 돌려받으니 무조건 이득"이라고 생각하지만,
      실제로는 <strong>① 전세대출 이자</strong>, <strong>② 보증금으로 묶인 내 현금의 기회비용</strong>,
      <strong>③ 월세 세액공제 여부</strong>를 함께 따져봐야 정확한 손익이 나옵니다.
    </p>
    <ul>
      <li><strong>전세 월 실질 비용</strong> = (전세대출금 × 대출금리 ÷ 12) + (투입 자기자본 × 기대수익률 ÷ 12) + 관리비</li>
      <li><strong>월세 월 실질 비용</strong> = 월세 + (보증금 대출이자) + (투입 자기자본 × 기대수익률 ÷ 12) + 관리비</li>
    </ul>

    <h3>자주 묻는 질문 (FAQ)</h3>
    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <div class="disclaimer-box">
      <strong>유의사항:</strong> 본 계산기는 이자·기회비용 기준 단순 비교 도구이며,
      전세보증보험료, 중개보수(복비), 월세 세액공제, 대출 원금 상환 조건 등은 별도로 고려하시기 바랍니다.
    </div>
  </article>

  <RelatedTools currentPath="/jeonse-vs-wolse/" />

  <script>
    import { bindWonInput, copySummaryWithUrl, formatKoreanUnit, formatWon, parseWon, setWonInputValue, shareCalculator } from '../lib/currency';

    const cashIn = document.getElementById('my-cash') as HTMLInputElement;
    const cashHint = document.getElementById('my-cash-kor') as HTMLElement;
    const yearsIn = document.getElementById('stay-years') as HTMLInputElement;
    const oppIn = document.getElementById('opp-rate') as HTMLInputElement;
    const jDepIn = document.getElementById('j-deposit') as HTMLInputElement;
    const jDepHint = document.getElementById('j-deposit-kor') as HTMLElement;
    const jRateIn = document.getElementById('j-loan-rate') as HTMLInputElement;
    const jMaintIn = document.getElementById('j-maint') as HTMLInputElement;
    const jMaintHint = document.getElementById('j-maint-kor') as HTMLElement;
    const wDepIn = document.getElementById('w-deposit') as HTMLInputElement;
    const wDepHint = document.getElementById('w-deposit-kor') as HTMLElement;
    const wRentIn = document.getElementById('w-rent') as HTMLInputElement;
    const wRentHint = document.getElementById('w-rent-kor') as HTMLElement;
    const wRateIn = document.getElementById('w-loan-rate') as HTMLInputElement;
    const wMaintIn = document.getElementById('w-maint') as HTMLInputElement;
    const wMaintHint = document.getElementById('w-maint-kor') as HTMLElement;

    let lastSummary = '';

    function update() {
      const cash = parseWon(cashIn.value);
      const years = Math.max(1, Number(yearsIn.value) || 1);
      const months = years * 12;
      const oppRate = Math.max(0, Number(oppIn.value) || 0) / 100;

      const jDep = parseWon(jDepIn.value);
      const jRate = Math.max(0, Number(jRateIn.value) || 0) / 100;
      const jMaint = parseWon(jMaintIn.value);

      const wDep = parseWon(wDepIn.value);
      const wRent = parseWon(wRentIn.value);
      const wRate = Math.max(0, Number(wRateIn.value) || 0) / 100;
      const wMaint = parseWon(wMaintIn.value);

      cashHint.textContent = formatKoreanUnit(cash);
      jDepHint.textContent = formatKoreanUnit(jDep);
      jMaintHint.textContent = formatKoreanUnit(jMaint);
      wDepHint.textContent = formatKoreanUnit(wDep);
      wRentHint.textContent = formatKoreanUnit(wRent);
      wMaintHint.textContent = formatKoreanUnit(wMaint);

      const jLoan = Math.max(0, jDep - cash);
      const jEquity = Math.min(jDep, cash);
      const jInterest = (jLoan * jRate) / 12;
      const jOpp = (jEquity * oppRate) / 12;
      const jMonthly = jInterest + jOpp + jMaint;
      const jTotal = jMonthly * months;

      const wLoan = Math.max(0, wDep - cash);
      const wEquity = Math.min(wDep, cash);
      const wInterest = (wLoan * wRate) / 12;
      const wOpp = (wEquity * oppRate) / 12;
      const wMonthly = wRent + wInterest + wOpp + wMaint;
      const wTotal = wMonthly * months;

      const breakeven = Math.max(0, jMonthly - (wInterest + wOpp + wMaint));

      const diffMonthly = wMonthly - jMonthly;
      const diffTotal = Math.abs(diffMonthly) * months;

      const box = document.getElementById('jw-box') as HTMLElement;
      const vLabel = document.getElementById('jw-verdict-label') as HTMLElement;
      const vFig = document.getElementById('jw-verdict-figure') as HTMLElement;
      const vSub = document.getElementById('jw-verdict-sub') as HTMLElement;

      box.classList.remove('is-warning');
      if (Math.abs(diffMonthly) < 1000) {
        vLabel.textContent = '전세와 월세의 실질 비용이 거의 같습니다';
        vFig.textContent = '동일 수준';
        vSub.textContent = '보증금 리스크와 보증보험료·복비를 고려해 선택하세요.';
      } else if (diffMonthly > 0) {
        vLabel.textContent = '전세가 더 유리합니다';
        vFig.textContent = `월 ${formatWon(diffMonthly)} 절약`;
        vSub.textContent = `${years}년 거주 기준 전세가 총 ${formatWon(diffTotal)} 더 저렴합니다.`;
      } else {
        box.classList.add('is-warning');
        vLabel.textContent = '월세가 더 유리합니다';
        vFig.textContent = `월 ${formatWon(Math.abs(diffMonthly))} 절약`;
        vSub.textContent = `${years}년 거주 기준 월세가 총 ${formatWon(diffTotal)} 더 저렴합니다.`;
      }

      (document.getElementById('j-loan') as HTMLElement).textContent = formatKoreanUnit(jLoan);
      (document.getElementById('w-loan') as HTMLElement).textContent = formatKoreanUnit(wLoan);
      (document.getElementById('j-interest') as HTMLElement).textContent = formatWon(jInterest);
      (document.getElementById('w-interest') as HTMLElement).textContent = formatWon(wInterest);
      (document.getElementById('w-rent-out') as HTMLElement).textContent = formatWon(wRent);
      (document.getElementById('j-opp') as HTMLElement).textContent = formatWon(jOpp);
      (document.getElementById('w-opp') as HTMLElement).textContent = formatWon(wOpp);
      (document.getElementById('j-maint-out') as HTMLElement).textContent = formatWon(jMaint);
      (document.getElementById('w-maint-out') as HTMLElement).textContent = formatWon(wMaint);
      (document.getElementById('j-monthly') as HTMLElement).textContent = formatWon(jMonthly);
      (document.getElementById('w-monthly') as HTMLElement).textContent = formatWon(wMonthly);
      (document.getElementById('stay-label') as HTMLElement).textContent = `${years}년`;
      (document.getElementById('j-total') as HTMLElement).textContent = formatWon(jTotal);
      (document.getElementById('w-total') as HTMLElement).textContent = formatWon(wTotal);
      (document.getElementById('breakeven-rent') as HTMLElement).textContent = `월 ${formatWon(breakeven)}`;

      lastSummary = `[얼마야] 전세 vs 월세 손익 비교 (${years}년 거주)\n- 전세 월 실질비용: ${formatWon(jMonthly)}\n- 월세 월 실질비용: ${formatWon(wMonthly)}\n- 판정: ${vLabel.textContent} (${vFig.textContent})\n- 손익분기 월세: 월 ${formatWon(breakeven)}`;
    }

    bindWonInput(cashIn, update, cashHint);
    bindWonInput(jDepIn, update, jDepHint);
    bindWonInput(jMaintIn, update, jMaintHint);
    bindWonInput(wDepIn, update, wDepHint);
    bindWonInput(wRentIn, update, wRentHint);
    bindWonInput(wMaintIn, update, wMaintHint);

    [yearsIn, oppIn, jRateIn, wRateIn].forEach((el) => el.addEventListener('input', update));

    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target || '') as HTMLInputElement | null;
        if (target && btn.dataset.val) {
          target.value = btn.dataset.val;
          update();
        }
      });
    });

    const btnCopy = document.getElementById('jw-copy') as HTMLButtonElement;
    btnCopy.addEventListener('click', () => copySummaryWithUrl(lastSummary, '/jeonse-vs-wolse/', btnCopy));

    const btnShare = document.getElementById('jw-share') as HTMLButtonElement;
    btnShare.addEventListener('click', () =>
      shareCalculator('얼마야 — 전세 vs 월세 진짜 손익 비교기', lastSummary, '/jeonse-vs-wolse/', btnShare)
    );

    const btnReset = document.getElementById('jw-reset') as HTMLButtonElement;
    btnReset.addEventListener('click', () => {
      [cashIn, jDepIn, jMaintIn, wDepIn, wRentIn, wMaintIn].forEach((el) => setWonInputValue(el, 0));
      yearsIn.value = '2';
      oppIn.value = '0';
      jRateIn.value = '0';
      wRateIn.value = '0';
      update();
      btnReset.textContent = '초기화 완료';
      setTimeout(() => (btnReset.textContent = '초기화'), 1200);
    });

    update();
  </script>
</BaseLayout>
