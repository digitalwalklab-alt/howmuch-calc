---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const faqItems = [
  {
    q: '간이과세자 기준 매출은 얼마인가요?',
    a: '연간 공급대가(부가세 포함 매출)가 1억 400만 원 미만인 개인사업자가 간이과세자 대상입니다(부동산임대업·과세유흥장소는 4,800만 원 미만). 이 중 연 매출이 4,800만 원 미만이면 부가가치세 납부가 면제됩니다.',
  },
  {
    q: '매입이 매출보다 많으면 간이과세자도 부가세 환급을 받을 수 있나요?',
    a: '아니요. 간이과세자는 부가가치세 환급이 불가능합니다. 창업 초기 인테리어·설비 투자나 상품 매입액이 매출보다 훨씬 큰 경우라면 일반과세자로 등록해야 매입세액 전액을 환급받을 수 있습니다.',
  },
  {
    q: '스마트스토어·쿠팡 셀러는 어떤 과세 유형이 유리한가요?',
    a: '소매업(전자상거래)의 간이과세 부가가치율은 15%로 매우 낮아(실효 부가세율 1.5%), 연매출 1억 400만 원 미만이고 마진이 일정 수준 이상이라면 대부분 간이과세자가 유리합니다. 단, B2B 거래로 세금계산서 발행이 필수라면 일반과세자를 고려해야 합니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '간이과세자 vs 일반과세자 부가가치세 비교기',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="간이과세자 vs 일반과세자 부가가치세 비교기"
  description="연간 매출과 매입액, 업종별 부가가치율을 원 단위로 입력해 간이과세자와 일반과세자의 예상 부가가치세 납부액·환급액과 유리한 사업자 유형을 바로 비교합니다."
  canonicalPath="/vat-compare/"
  breadcrumbCategory="세무 · N잡"
  jsonLd={jsonLd}
>
  <div class="calc-header">
    <nav class="breadcrumb" aria-label="경로">
      <a href="/">얼마야</a>
      <span>/</span>
      <span>세무 · N잡</span>
    </nav>
    <h1>간이과세자 vs 일반과세자 부가가치세 비교기</h1>
    <p class="page-lead">
      1인 사업자·스마트스토어·소상공인을 위해 매출·매입 조건에 따른 간이과세자와 일반과세자의 부가세 차이를 원 단위로 계산합니다.
    </p>
  </div>

  <div class="calc-grid">
    <section class="panel" aria-label="입력 조건">
      <div class="panel-title">
        <span>매출 · 매입 · 업종 입력</span>
      </div>

      <div class="field">
        <label class="field-label" for="vat-sales">
          <span>연간 총매출 (부가세 포함)</span>
          <span class="field-hint num" id="vat-sales-kor">6,000만원</span>
        </label>
        <div class="input-wrap">
          <input type="text" inputmode="numeric" autocomplete="off" id="vat-sales" class="input-text has-unit num" value="60,000,000" />
          <span class="input-unit">원</span>
        </div>
        <div class="preset-row">
          <button type="button" class="preset-btn" data-target="vat-sales" data-val="40000000">4,000만</button>
          <button type="button" class="preset-btn" data-target="vat-sales" data-val="60000000">6,000만</button>
          <button type="button" class="preset-btn" data-target="vat-sales" data-val="90000000">9,000만</button>
          <button type="button" class="preset-btn" data-target="vat-sales" data-val="120000000">1억 2,000만</button>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="vat-buy">
          <span>연간 매입액 (세금계산서·카드 등 부가세 포함)</span>
          <span class="field-hint num" id="vat-buy-kor">2,000만원</span>
        </label>
        <div class="input-wrap">
          <input type="text" inputmode="numeric" autocomplete="off" id="vat-buy" class="input-text has-unit num" value="20,000,000" />
          <span class="input-unit">원</span>
        </div>
        <div class="preset-row">
          <button type="button" class="preset-btn" data-target="vat-buy" data-val="5000000">500만</button>
          <button type="button" class="preset-btn" data-target="vat-buy" data-val="20000000">2,000만</button>
          <button type="button" class="preset-btn" data-target="vat-buy" data-val="45000000">4,500만</button>
          <button type="button" class="preset-btn" data-target="vat-buy" data-val="70000000">7,000만</button>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="vat-industry">
          <span>업종별 부가가치율 (간이과세 기준)</span>
        </label>
        <select id="vat-industry" class="input-select">
          <option value="15" selected>소매업 · 전자상거래(스마트스토어) · 음식점 (15%)</option>
          <option value="20">제조업 · 농임어업 · 숙박업 (20%)</option>
          <option value="30">건설업 · 운수업 · 정보통신업 (30%)</option>
          <option value="40">전문·과학·기술 · 사업지원 · 부동산임대 (40%)</option>
        </select>
      </div>
    </section>

    <section class="panel panel-result" aria-live="polite" aria-label="비교 결과">
      <div class="panel-title">
        <span>부가가치세 유불리 비교</span>
      </div>

      <div class="result-summary" id="vat-box">
        <div class="result-label" id="vat-verdict-label">간이과세자가 더 유리합니다</div>
        <div class="result-figure num" id="vat-verdict-fig">연 0원 절세</div>
        <div class="result-sub" id="vat-verdict-sub">매출과 매입 구조에 따른 연간 예상 부가세 차이입니다.</div>
      </div>

      <table class="ledger">
        <thead>
          <tr style="border-bottom: 2px solid var(--border);">
            <th>비교 항목 (연간)</th>
            <th style="text-align: right;">간이과세자</th>
            <th style="text-align: right;">일반과세자</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>매출세액</th>
            <td id="v-s-sales">0원</td>
            <td id="v-g-sales">0원</td>
          </tr>
          <tr>
            <th>매입세액 공제</th>
            <td id="v-s-buy">0원</td>
            <td id="v-g-buy">0원</td>
          </tr>
          <tr class="total-row">
            <th>예상 부가세 (납부/환급)</th>
            <td id="v-s-total">0원</td>
            <td id="v-g-total">0원</td>
          </tr>
        </tbody>
      </table>

      <div class="disclaimer-box" id="vat-note-box" style="margin-top: 16px;">
        <strong>과세 기준 안내:</strong> <span id="vat-note-text">연매출 1억 400만 원 미만으로 간이과세 적용이 가능합니다.</span>
      </div>

      <div class="action-row">
        <button type="button" class="btn-secondary" id="vat-copy">결과 복사</button>
        <button type="button" class="btn-secondary" id="vat-reset">초기화</button>
      </div>
    </section>
  </div>

  <article class="guide-section">
    <h2>간이과세자 vs 일반과세자 계산 공식</h2>
    <ul>
      <li><strong>일반과세자:</strong> <code>(매출액 ÷ 1.1 × 10%) − (매입액 ÷ 1.1 × 10%)</code>. 매입세액이 매출세액보다 크면 차액을 환급받습니다.</li>
      <li><strong>간이과세자:</strong> <code>(매출액 × 업종별 부가가치율 × 10%) − (매입액 × 0.5%)</code>. 연 매출 4,800만 원 미만이면 납부가 면제되며, 환급은 불가합니다.</li>
    </ul>

    <h3>자주 묻는 질문 (FAQ)</h3>
    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <div class="disclaimer-box">
      <strong>유의사항:</strong> 본 계산기는 신용카드 발행세액공제, 의제매입세액공제 등 특수 공제를 제외한 기본 부가세 비교 시뮬레이션입니다. 업종별 간이과세 배제 여부와 정확한 세액은 홈택스 또는 세무사를 통해 확인하세요.
    </div>
  </article>

  <RelatedTools currentPath="/vat-compare/" />

  <script>
    import { bindWonInput, formatKoreanUnit, formatWon, parseWon, setWonInputValue } from '../lib/currency';

    const salesIn = document.getElementById('vat-sales') as HTMLInputElement;
    const salesHint = document.getElementById('vat-sales-kor') as HTMLElement;
    const buyIn = document.getElementById('vat-buy') as HTMLInputElement;
    const buyHint = document.getElementById('vat-buy-kor') as HTMLElement;
    const indSel = document.getElementById('vat-industry') as HTMLSelectElement;

    let lastSummary = '';

    function update() {
      const sales = parseWon(salesIn.value);
      const buy = parseWon(buyIn.value);
      const valRate = Number(indSel.value) / 100;

      salesHint.textContent = formatKoreanUnit(sales);
      buyHint.textContent = formatKoreanUnit(buy);

      const gSalesTax = Math.round((sales / 1.1) * 0.1);
      const gBuyTax = Math.round((buy / 1.1) * 0.1);
      const gTotal = gSalesTax - gBuyTax;

      const isOverLimit = sales >= 104_000_000;
      const isExempt = sales > 0 && sales < 48_000_000;
      const sSalesTax = Math.round(sales * valRate * 0.1);
      const sBuyTax = Math.round(buy * 0.005);
      const sTotal = isExempt || sales === 0 ? 0 : Math.max(0, sSalesTax - sBuyTax);

      (document.getElementById('v-s-sales') as HTMLElement).textContent = isOverLimit ? '적용 불가' : formatWon(sSalesTax);
      (document.getElementById('v-s-buy') as HTMLElement).textContent = isOverLimit ? '-' : `- ${formatWon(sBuyTax)}`;
      (document.getElementById('v-g-sales') as HTMLElement).textContent = formatWon(gSalesTax);
      (document.getElementById('v-g-buy') as HTMLElement).textContent = `- ${formatWon(gBuyTax)}`;

      const sTotEl = document.getElementById('v-s-total') as HTMLElement;
      const gTotEl = document.getElementById('v-g-total') as HTMLElement;

      sTotEl.textContent = isOverLimit ? '일반과세 전환' : isExempt ? '0원 (납부면제)' : formatWon(sTotal);
      gTotEl.textContent = gTotal < 0 ? `환급 ${formatWon(Math.abs(gTotal))}` : formatWon(gTotal);
      gTotEl.className = gTotal < 0 ? 'pos' : '';

      const box = document.getElementById('vat-box') as HTMLElement;
      const vLabel = document.getElementById('vat-verdict-label') as HTMLElement;
      const vFig = document.getElementById('vat-verdict-fig') as HTMLElement;
      const vSub = document.getElementById('vat-verdict-sub') as HTMLElement;
      const noteText = document.getElementById('vat-note-text') as HTMLElement;

      box.classList.remove('is-warning');
      if (sales === 0 && buy === 0) {
        vLabel.textContent = '매출과 매입액을 입력해주세요';
        vFig.textContent = '0원';
        vSub.textContent = '연간 매출·매입을 입력하면 유리한 과세 유형을 판정합니다.';
        noteText.textContent = '연매출 4,800만 원 미만은 간이과세 납부면제, 1억 400만 원 이상은 일반과세 적용 대상입니다.';
      } else if (isOverLimit) {
        box.classList.add('is-warning');
        vLabel.textContent = '일반과세자 대상입니다 (연매출 1억 400만 원 이상)';
        vFig.textContent = gTotal < 0 ? `환급 ${formatWon(Math.abs(gTotal))}` : `납부 ${formatWon(gTotal)}`;
        vSub.textContent = '간이과세 기준 매출을 초과하여 일반과세자로 부가가치세를 신고합니다.';
        noteText.textContent = '직전 연도 매출이 1억 400만 원 이상이면 다음 해 7월부터 일반과세자로 전환됩니다.';
      } else if (gTotal < sTotal) {
        box.classList.add('is-warning');
        const diff = sTotal - gTotal;
        vLabel.textContent = '일반과세자가 더 유리합니다';
        vFig.textContent = `연 ${formatWon(diff)} 유리`;
        vSub.textContent =
          gTotal < 0
            ? `매입이 많아 일반과세자는 ${formatWon(Math.abs(gTotal))} 환급이 가능합니다 (간이과세는 환급 불가).`
            : '매입 비중이 높아 일반과세자의 매입세액 공제가 더 큽니다.';
        noteText.textContent = isExempt
          ? '연매출 4,800만 원 미만으로 간이과세 납부면제 대상이지만, 매입 환급이 크다면 일반과세가 유리합니다.'
          : '초기 설비·인테리어·상품 매입이 큰 시점에는 일반과세자 선택을 검토하세요.';
      } else {
        const diff = gTotal - sTotal;
        vLabel.textContent = '간이과세자가 더 유리합니다';
        vFig.textContent = `연 ${formatWon(diff)} 절세`;
        vSub.textContent = isExempt
          ? '연매출 4,800만 원 미만으로 간이과세 부가세 납부면제 혜택이 적용됩니다.'
          : `일반과세자(${formatWon(gTotal)}) 대비 간이과세자(${formatWon(sTotal)}) 부담이 훨씬 적습니다.`;
        noteText.textContent = isExempt
          ? '연매출 4,800만 원 미만 구간은 간이과세 부가세 납부가 면제(0원)됩니다.'
          : '연매출 1억 400만 원 미만 구간으로 간이과세 적용이 가능합니다.';
      }

      lastSummary = `[얼마야] 간이 vs 일반 부가세 비교\n- 연매출: ${formatWon(sales)} / 연매입: ${formatWon(buy)}\n- 간이과세자: ${sTotEl.textContent}\n- 일반과세자: ${gTotEl.textContent}\n- 판정: ${vLabel.textContent} (${vFig.textContent})`;
    }

    bindWonInput(salesIn, update, salesHint);
    bindWonInput(buyIn, update, buyHint);
    indSel.addEventListener('change', update);

    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target || '') as HTMLInputElement | null;
        if (target && btn.dataset.val) {
          setWonInputValue(target, Number(btn.dataset.val));
          update();
        }
      });
    });

    const btnCopy = document.getElementById('vat-copy') as HTMLButtonElement;
    btnCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastSummary);
        btnCopy.textContent = '복사 완료!';
        setTimeout(() => (btnCopy.textContent = '결과 복사'), 1500);
      } catch {
        btnCopy.textContent = '복사 실패';
        setTimeout(() => (btnCopy.textContent = '결과 복사'), 1500);
      }
    });

    const btnReset = document.getElementById('vat-reset') as HTMLButtonElement;
    btnReset.addEventListener('click', () => {
      setWonInputValue(salesIn, 0);
      setWonInputValue(buyIn, 0);
      indSel.value = '15';
      update();
      btnReset.textContent = '초기화 완료';
      setTimeout(() => (btnReset.textContent = '초기화'), 1200);
    });

    update();
  </script>
</BaseLayout>
