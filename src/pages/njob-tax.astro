---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const faqItems = [
  {
    q: '직장인 부업 수익이 얼마 이상이면 5월 종합소득세 신고를 해야 하나요?',
    a: '사업소득(3.3% 프리랜서, 블로그 애드센스, 스마트스토어 등)은 금액이 1원이라도 발생하면 다음 해 5월 종합소득세 신고 대상입니다. 단, 일시적·우발적인 기타소득은 연간 기타소득금액 300만 원 이하일 때 분리과세를 선택할 수 있습니다.',
  },
  {
    q: '직장인 부업 때문에 건강보험료가 추가로 나오나요?',
    a: '직장가입자의 근로소득 외 연간 합산 소득금액(필요경비 제외 후)이 2,000만 원을 초과하는 경우, 2,000만 원 초과분에 대해서만 소득월액 건강보험료가 추가로 부과됩니다. 2,000만 원 이하라면 건보료 추가 부담은 없습니다.',
  },
  {
    q: '부업 수익이 본업 연봉과 합산되면 세율이 왜 높아지나요?',
    a: '종합소득세는 1년간의 근로소득금액과 사업소득금액을 합산한 과세표준에 6%~45% 누진세율을 적용합니다. 본업만으로 이미 15% 또는 24% 구간에 있다면, 부업 소득은 그 위 구간 세율부터 바로 적용되기 때문입니다.',
  },
  {
    q: '회사에 부업 사실이 알려질 수 있나요?',
    a: '5월 종합소득세 신고는 개인이 홈택스에서 직접 진행하므로 회사에 통보되지 않습니다. 다만 근로 외 소득금액이 연 2,000만 원을 넘어 소득월액 건보료가 별도 고지되는 경우에도 본인 주소지로 따로 고지되므로 회사 급여담당자에게 자동 통보되지는 않습니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '직장인 + 부업(N잡) 합산 종합소득세 시뮬레이터',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="직장인 + 부업(N잡) 합산 종합소득세 시뮬레이터"
  description="본업 연봉에 블로그·프리랜서·스마트스토어 등 부업 수익이 더해질 때 5월 종합소득세 추가 납부액과 부업 실수령액, 건보료 초과 여부를 원 단위로 정확하게 계산합니다."
  canonicalPath="/njob-tax/"
  breadcrumbCategory="세무 · N잡"
  jsonLd={jsonLd}
>
  <div class="calc-header">
    <nav class="breadcrumb" aria-label="경로">
      <a href="/">얼마야</a>
      <span>/</span>
      <span>세무 · N잡</span>
    </nav>
    <h1>직장인 + 부업(N잡) 합산 종합소득세 시뮬레이터</h1>
    <p class="page-lead">
      본업 연봉에 부업 수익이 합산될 때 세율 구간이 어떻게 바뀌고, 5월 종소세에서 얼마를 더 내야 하는지 원 단위로 미리 확인하세요.
    </p>
  </div>

  <div class="calc-grid">
    <section class="panel" aria-label="입력 조건">
      <div class="panel-title">
        <span>본업 · 부업 수익 입력</span>
      </div>

      <div class="field">
        <label class="field-label" for="main-salary">
          <span>본업 연봉 (세전 총급여)</span>
          <span class="field-hint num" id="main-salary-kor">5,000만원</span>
        </label>
        <div class="input-wrap">
          <input type="text" inputmode="numeric" autocomplete="off" id="main-salary" class="input-text has-unit num" value="50,000,000" />
          <span class="input-unit">원</span>
        </div>
        <div class="preset-row">
          <button type="button" class="preset-btn" data-target="main-salary" data-val="36000000">3,600만</button>
          <button type="button" class="preset-btn" data-target="main-salary" data-val="50000000">5,000만</button>
          <button type="button" class="preset-btn" data-target="main-salary" data-val="70000000">7,000만</button>
          <button type="button" class="preset-btn" data-target="main-salary" data-val="100000000">1억</button>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="side-gross">
          <span>부업 연간 총수입 (세전)</span>
          <span class="field-hint num" id="side-gross-kor">1,200만원</span>
        </label>
        <div class="input-wrap">
          <input type="text" inputmode="numeric" autocomplete="off" id="side-gross" class="input-text has-unit num" value="12,000,000" />
          <span class="input-unit">원</span>
        </div>
        <div class="preset-row">
          <button type="button" class="preset-btn" data-target="side-gross" data-val="5000000">500만</button>
          <button type="button" class="preset-btn" data-target="side-gross" data-val="12000000">1,200만</button>
          <button type="button" class="preset-btn" data-target="side-gross" data-val="24000000">2,400만</button>
          <button type="button" class="preset-btn" data-target="side-gross" data-val="40000000">4,000만</button>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="side-job">
          <span>부업 유형 (단순경비율 기준)</span>
        </label>
        <select id="side-job" class="input-select">
          <option value="64.1" selected>블로그·유튜브·애드센스·IT·콘텐츠 (64.1%)</option>
          <option value="86.0">스마트스토어·쿠팡·전자상거래 도소매 (86.0%)</option>
          <option value="79.4">배달라이더·대리운전·운송 (79.4%)</option>
          <option value="61.7">전자책·강의·과외·교육 (61.7%)</option>
          <option value="custom">경비율 직접 입력</option>
        </select>
      </div>

      <div class="field" id="side-custom-wrap" style="display: none;">
        <label class="field-label" for="side-custom-rate"><span>직접 입력 경비율</span></label>
        <div class="input-wrap">
          <input type="number" id="side-custom-rate" class="input-text has-unit num" value="64.1" min="0" max="95" step="0.1" />
          <span class="input-unit">%</span>
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <span class="field-label"><span>부업 3.3% 원천징수 여부</span></span>
          <div class="segmented" role="radiogroup" aria-label="3.3% 원천징수 여부">
            <button type="button" class="seg-btn active" id="withhold-no">안 뗌 (애드센스·스토어)</button>
            <button type="button" class="seg-btn" id="withhold-yes">3.3% 공제됨</button>
          </div>
        </div>
        <div class="field">
          <label class="field-label" for="njob-dep"><span>부양가족 수 (본인 포함)</span></label>
          <div class="input-wrap">
            <input type="number" id="njob-dep" class="input-text has-unit num" value="1" min="1" max="10" step="1" />
            <span class="input-unit">명</span>
          </div>
        </div>
      </div>
    </section>

    <section class="panel panel-result" aria-live="polite" aria-label="계산 결과">
      <div class="panel-title">
        <span>5월 합산 종소세 예상 결과</span>
      </div>

      <div class="result-summary is-warning" id="njob-box">
        <div class="result-label" id="njob-status-label">5월 추가 납부 예상 세액</div>
        <div class="result-figure num" id="njob-main">0원</div>
        <div class="result-sub" id="njob-sub">부업 수익으로 인해 추가로 발생하는 소득세·지방소득세입니다.</div>
      </div>

      <table class="ledger">
        <tbody>
          <tr>
            <th>본업 근로소득금액 (근로소득공제 후)</th>
            <td id="n-main-inc">0원</td>
          </tr>
          <tr>
            <th>부업 사업소득금액 (경비율 <span id="n-rate">64.1%</span>)</th>
            <td id="n-side-inc">0원</td>
          </tr>
          <tr>
            <th>합산 과세표준 (적용세율 <span id="n-bracket">15%</span>)</th>
            <td id="n-taxbase">0원</td>
          </tr>
          <tr>
            <th>부업으로 증가한 총 세금 (지방세 포함)</th>
            <td id="n-extra-tax" class="neg">0원</td>
          </tr>
          <tr>
            <th>부업 기납부 3.3% 세액</th>
            <td id="n-withheld">0원</td>
          </tr>
          <tr class="total-row">
            <th id="n-final-label">5월 예상 추가납부액</th>
            <td id="n-final" class="neg">0원</td>
          </tr>
          <tr>
            <th>부업 실질 순수익 (총수입 − 증가세금)</th>
            <td id="n-side-net" class="pos">0원</td>
          </tr>
        </tbody>
      </table>

      <div class="disclaimer-box" id="njob-health-box" style="margin-top: 16px;">
        <strong>건강보험료 추가 부과 여부:</strong> <span id="n-health-msg">부업 소득금액이 2,000만 원 이하라 추가 건보료가 없습니다.</span>
      </div>

      <div class="action-row">
        <button type="button" class="btn-secondary" id="njob-copy">결과 복사</button>
        <button type="button" class="btn-secondary" id="njob-reset">초기화</button>
      </div>
    </section>
  </div>

  <article class="guide-section">
    <h2>직장인 N잡러가 5월 종소세에서 꼭 알아야 할 3가지</h2>
    <ol>
      <li><strong>합산 누진세율 주의:</strong> 본업 연봉이 5,000만 원 안팎이면 이미 과세표준 15% 구간에 걸쳐 있어, 부업 소득금액에는 최소 16.5%(지방소득세 포함)부터 세금이 붙습니다.</li>
      <li><strong>경비율과 증빙 관리:</strong> 애드센스·프리랜서·스마트스토어 모두 실제 지출한 사업 경비(장비, 서버비, 광고비, 상품 매입비)가 단순경비율보다 크다면 간편장부로 신고하는 것이 유리합니다.</li>
      <li><strong>건보료 2,000만 원 기준:</strong> '매출'이 아니라 필요경비를 뺀 <strong>'소득금액'</strong>이 연 2,000만 원을 초과할 때만 초과분에 대해 직장 외 소득월액 건강보험료가 부과됩니다.</li>
    </ol>

    <h3>자주 묻는 질문 (FAQ)</h3>
    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <div class="disclaimer-box">
      <strong>유의사항:</strong> 본 시뮬레이터는 근로소득공제, 기본 인적공제(1인 150만 원), 4대보험 공제 근사치 및
      부업 단순경비율을 적용한 추정치입니다. 연말정산 시 신용카드·의료비·연금저축 등 추가 공제 내역에 따라 실제 홈택스 세액과 차이가 발생할 수 있습니다.
    </div>
  </article>

  <RelatedTools currentPath="/njob-tax/" />

  <script>
    import { bindWonInput, formatKoreanUnit, formatWon, parseWon, setWonInputValue } from '../lib/currency';

    function calcEarnedDeduction(salary: number): number {
      if (salary <= 5_000_000) return salary * 0.7;
      if (salary <= 15_000_000) return 3_500_000 + (salary - 5_000_000) * 0.4;
      if (salary <= 45_000_000) return 7_500_000 + (salary - 15_000_000) * 0.15;
      if (salary <= 100_000_000) return 12_000_000 + (salary - 45_000_000) * 0.05;
      return Math.min(20_000_000, 14_750_000 + (salary - 100_000_000) * 0.02);
    }

    function calcTax(base: number): { tax: number; rate: number } {
      if (base <= 0) return { tax: 0, rate: 0 };
      if (base <= 14_000_000) return { tax: base * 0.06, rate: 6 };
      if (base <= 50_000_000) return { tax: base * 0.15 - 1_260_000, rate: 15 };
      if (base <= 88_000_000) return { tax: base * 0.24 - 5_760_000, rate: 24 };
      if (base <= 150_000_000) return { tax: base * 0.35 - 15_440_000, rate: 35 };
      if (base <= 300_000_000) return { tax: base * 0.38 - 19_940_000, rate: 38 };
      if (base <= 500_000_000) return { tax: base * 0.40 - 25_940_000, rate: 40 };
      if (base <= 1_000_000_000) return { tax: base * 0.42 - 35_940_000, rate: 42 };
      return { tax: base * 0.45 - 65_940_000, rate: 45 };
    }

    const mainIn = document.getElementById('main-salary') as HTMLInputElement;
    const mainHint = document.getElementById('main-salary-kor') as HTMLElement;
    const sideIn = document.getElementById('side-gross') as HTMLInputElement;
    const sideHint = document.getElementById('side-gross-kor') as HTMLElement;
    const jobSel = document.getElementById('side-job') as HTMLSelectElement;
    const customWrap = document.getElementById('side-custom-wrap') as HTMLElement;
    const customIn = document.getElementById('side-custom-rate') as HTMLInputElement;
    const depIn = document.getElementById('njob-dep') as HTMLInputElement;
    const btnNo = document.getElementById('withhold-no') as HTMLButtonElement;
    const btnYes = document.getElementById('withhold-yes') as HTMLButtonElement;

    let isWithheld = false;
    let lastSummary = '';

    function update() {
      const mainSalary = parseWon(mainIn.value);
      const sideGross = parseWon(sideIn.value);
      mainHint.textContent = formatKoreanUnit(mainSalary);
      sideHint.textContent = formatKoreanUnit(sideGross);

      const rate =
        jobSel.value === 'custom'
          ? Math.min(95, Math.max(0, Number(customIn.value) || 0))
          : Number(jobSel.value);
      const dep = Math.max(1, Math.floor(Number(depIn.value) || 1));

      const mainIncome = Math.max(0, mainSalary - calcEarnedDeduction(mainSalary));
      const sideIncome = Math.max(0, sideGross * (1 - rate / 100));

      const baseDeduction = dep * 1_500_000 + Math.min(8_000_000, mainSalary * 0.085);

      const baseOnlyMain = Math.max(0, mainIncome - baseDeduction);
      const baseCombined = Math.max(0, mainIncome + sideIncome - baseDeduction);

      const taxMain = calcTax(baseOnlyMain).tax;
      const combinedRes = calcTax(baseCombined);
      const extraIncomeTax = Math.max(0, combinedRes.tax - taxMain);
      const extraTotalTax = Math.round(extraIncomeTax * 1.1);

      const withheld = isWithheld ? Math.round(sideGross * 0.033) : 0;
      const netPayDue = extraTotalTax - withheld;
      const sideNet = Math.max(0, sideGross - extraTotalTax);

      (document.getElementById('n-main-inc') as HTMLElement).textContent = formatWon(mainIncome);
      (document.getElementById('n-rate') as HTMLElement).textContent = `${rate.toFixed(1)}%`;
      (document.getElementById('n-side-inc') as HTMLElement).textContent = formatWon(sideIncome);
      (document.getElementById('n-bracket') as HTMLElement).textContent = `${combinedRes.rate}%`;
      (document.getElementById('n-taxbase') as HTMLElement).textContent = formatWon(baseCombined);
      (document.getElementById('n-extra-tax') as HTMLElement).textContent = formatWon(extraTotalTax);
      (document.getElementById('n-withheld') as HTMLElement).textContent = formatWon(withheld);
      (document.getElementById('n-side-net') as HTMLElement).textContent = formatWon(sideNet);

      const box = document.getElementById('njob-box') as HTMLElement;
      const sLabel = document.getElementById('njob-status-label') as HTMLElement;
      const mainFig = document.getElementById('njob-main') as HTMLElement;
      const subTxt = document.getElementById('njob-sub') as HTMLElement;
      const fLabel = document.getElementById('n-final-label') as HTMLElement;
      const fVal = document.getElementById('n-final') as HTMLElement;

      box.classList.remove('is-warning', 'is-danger');
      if (netPayDue > 0) {
        box.classList.add('is-danger');
        sLabel.textContent = '5월 추가 납부 예상 세액';
        mainFig.textContent = formatWon(netPayDue);
        subTxt.textContent = `부업으로 증가한 총 세금 ${formatWon(extraTotalTax)} 중 기납부 3.3%를 제외한 금액입니다.`;
        fLabel.textContent = '5월 예상 추가납부액';
        fVal.textContent = formatWon(netPayDue);
        fVal.className = 'neg';
      } else {
        sLabel.textContent = '5월 예상 환급액';
        mainFig.textContent = `+ ${formatWon(Math.abs(netPayDue))}`;
        subTxt.textContent = '미리 낸 3.3% 원천징수 세액이 부업 증가 세액보다 많아 환급이 예상됩니다.';
        fLabel.textContent = '5월 예상 환급액';
        fVal.textContent = `+ ${formatWon(Math.abs(netPayDue))}`;
        fVal.className = 'pos';
      }

      const healthMsg = document.getElementById('n-health-msg') as HTMLElement;
      const healthBox = document.getElementById('njob-health-box') as HTMLElement;
      if (sideIncome > 20_000_000) {
        const excess = sideIncome - 20_000_000;
        const estHealthMonth = Math.round((excess / 12) * 0.08);
        healthMsg.textContent = `부업 소득금액이 2,000만 원을 ${formatWon(excess)} 초과하여 월 약 ${formatWon(estHealthMonth)} 수준의 추가 건보료가 부과될 수 있습니다.`;
        healthBox.style.background = 'var(--warning-bg)';
        healthBox.style.borderColor = '#fde68a';
        healthBox.style.color = 'var(--warning)';
      } else {
        healthMsg.textContent = '부업 소득금액이 2,000만 원 이하이므로 직장 외 추가 건강보험료는 발생하지 않습니다.';
        healthBox.style.background = 'var(--surface-tint)';
        healthBox.style.borderColor = '#cce7e4';
        healthBox.style.color = 'var(--brand-ink)';
      }

      lastSummary = `[얼마야] 직장인+부업 합산 종소세 예상\n- 본업 연봉: ${formatWon(mainSalary)}\n- 부업 수입: ${formatWon(sideGross)} (경비율 ${rate}%)\n- 부업 증가 세금: ${formatWon(extraTotalTax)}\n- 5월 예상 정산: ${netPayDue >= 0 ? '추가납부 ' + formatWon(netPayDue) : '환급 +' + formatWon(Math.abs(netPayDue))}`;
    }

    bindWonInput(mainIn, update, mainHint);
    bindWonInput(sideIn, update, sideHint);

    btnNo.addEventListener('click', () => {
      isWithheld = false;
      btnNo.classList.add('active');
      btnYes.classList.remove('active');
      update();
    });

    btnYes.addEventListener('click', () => {
      isWithheld = true;
      btnYes.classList.add('active');
      btnNo.classList.remove('active');
      update();
    });

    jobSel.addEventListener('change', () => {
      customWrap.style.display = jobSel.value === 'custom' ? '' : 'none';
      update();
    });

    [customIn, depIn].forEach((el) => el.addEventListener('input', update));

    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target || '') as HTMLInputElement | null;
        if (target && btn.dataset.val) {
          setWonInputValue(target, Number(btn.dataset.val));
          update();
        }
      });
    });

    const btnCopy = document.getElementById('njob-copy') as HTMLButtonElement;
    btnCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastSummary);
        btnCopy.textContent = '복사 완료!';
        setTimeout(() => (btnCopy.textContent = '결과 복사'), 1500);
      } catch {
        btnCopy.textContent = '복사 실패';
        setTimeout(() => (btnCopy.textContent = '결과 복사'), 1500);
      }
    });

    const btnReset = document.getElementById('njob-reset') as HTMLButtonElement;
    btnReset.addEventListener('click', () => {
      setWonInputValue(mainIn, 0);
      setWonInputValue(sideIn, 0);
      jobSel.value = '64.1';
      customWrap.style.display = 'none';
      customIn.value = '64.1';
      depIn.value = '1';
      isWithheld = false;
      btnNo.classList.add('active');
      btnYes.classList.remove('active');
      update();
      btnReset.textContent = '초기화 완료';
      setTimeout(() => (btnReset.textContent = '초기화'), 1200);
    });

    update();
  </script>
</BaseLayout>
