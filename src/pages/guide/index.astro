---
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = [
  {
    href: '/guide/year-end-tax-card-25/',
    category: '연말정산 · 절세',
    title: '2026 연말정산 신용카드 25% 황금비율 & 체크카드 전환 시점 총정리',
    desc: '총급여의 25%까지는 신용카드, 초과분은 체크카드·현금영수증·전통시장을 써야 하는 이유와 연금저축·IRP 900만 원 막판 절세 전략을 사례별로 정리했습니다.',
    calcHref: '/year-end-tax/',
    calcLabel: '연말정산 시뮬레이터 바로가기',
  },
  {
    href: '/guide/njob-health-insurance-2000/',
    category: 'N잡 · 프리랜서 세무',
    title: '직장인 부업(N잡) 건강보험료 2,000만 원 기준과 5월 종소세 절세 전략',
    desc: '블로그 애드센스·스마트스토어·3.3% 프리랜서 부업 시 매출과 소득금액의 차이, 건보료 추가 부과 기준, 회사 통보 여부까지 한 번에 정리합니다.',
    calcHref: '/njob-tax/',
    calcLabel: '직장인 N잡 종소세 계산기',
  },
  {
    href: '/guide/jeonse-vs-wolse-checklist/',
    category: '주거 · 대출',
    title: '전세 vs 월세 결정 전 꼭 따져야 할 기회비용·손익분기 월세 계산법',
    desc: '전세대출 이자와 보유 현금 기회비용, 월세 세액공제까지 반영해 내 조건에서 전세와 월세 중 진짜 유리한 선택을 가르는 기준을 알려드립니다.',
    calcHref: '/jeonse-vs-wolse/',
    calcLabel: '전세 vs 월세 손익 비교기',
  },
  {
    href: '/guide/severance-unemployment-tips/',
    category: '퇴사 · 급여',
    title: '퇴사 전 반드시 챙겨야 할 퇴직금·미사용 연차수당·실업급여 체크리스트',
    desc: '퇴직금 평균임금 높이는 시점, 미사용 연차수당 정산 기준, 자발적 퇴사에도 실업급여가 인정되는 예외 사유까지 실전 핵심만 모았습니다.',
    calcHref: '/severance-total/',
    calcLabel: '퇴사 총수령액 통합 계산기',
  },
];
---

<BaseLayout
  title="실전 금융·세무 가이드"
  description="연말정산 카드 25% 황금비율, 직장인 N잡 건보료 2,000만 원 기준, 전세 vs 월세 기회비용, 퇴사 총수령액 체크리스트 등 실전 절세·금융 가이드 모음."
  canonicalPath="/guide/"
  breadcrumbCategory="가이드"
>
  <section class="home-hero">
    <nav class="breadcrumb" aria-label="경로">
      <a href="/">얼마야</a>
      <span>/</span>
      <span>실전 가이드</span>
    </nav>
    <h1>실전 금융·세무 가이드</h1>
    <p class="page-lead">
      계산기 숫자의 배경이 되는 최신 세법·근로기준·주거 의사결정 핵심만 알기 쉽게 정리했습니다.
      각 가이드에서 바로 본인 조건을 대입해 계산해 볼 수 있습니다.
    </p>
  </section>

  <section class="tool-list" aria-label="가이드 목록">
    {guides.map((g) => (
      <article class="tool-row">
        <div>
          <span class="tool-cat">{g.category}</span>
          <h2><a href={g.href}>{g.title}</a></h2>
          <p>{g.desc}</p>
          <div class="tool-tags">
            <a href={g.calcHref}>
              {g.calcLabel} →
            </a>
          </div>
        </div>
        <a href={g.href} class="tool-cta">
          가이드 읽기
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
