---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedTools from '../components/RelatedTools.astro';

const faqItems = [
  {
    q: '프리랜서 3.3% 원천징수는 무조건 환급받나요?',
    a: '아닙니다. 1년간 미리 낸 3.3% 세금(기납부세액)이 5월 종합소득세 신고 시 산출된 최종 결정세액보다 많으면 환급을 받고, 반대로 총수입이 높거나 필요경비가 적어 결정세액이 더 크면 차액을 추가로 납부해야 합니다.',
  },
  {
    q: '단순경비율은 누구나 적용할 수 있나요?',
    a: '직전 연도 수입금액이 업종별 기준금액 미만(인적용역 프리랜서 기준 보통 3,600만 원 미만)이거나 해당 연도 신규 사업자인 경우 단순경비율을 적용할 수 있습니다. 기준을 초과하면 기준경비율 또는 간편장부 기장 방식으로 신고해야 합니다.',
  },
  {
    q: '3.3%는 정확히 어떤 세금으로 구성되어 있나요?',
    a: '국세인 사업소득세 3%와 지방자치단체에 내는 지방소득세 0.3%(소득세의 10%)를 합친 비율입니다. 예를 들어 100만 원을 청구하면 33,000원을 공제하고 967,000원을 입금받게 됩니다.',
  },
  {
    q: '직장인이 부업으로 3.3% 수입을 얻은 경우에도 같은 계산이 적용되나요?',
    a: '직장인 N잡러는 근로소득과 사업소득(프리랜서 수입)을 합산해 5월 종합소득세를 신고해야 합니다. 근로소득이 이미 높은 누진세율 구간에 걸쳐 있다면, 이 계산기 결과보다 추가 납부 세액이 더 커질 수 있습니다.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '프리랜서 3.3% 실수령액 및 종합소득세 환급 계산기',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="프리랜서 3.3% 실수령액 & 종합소득세 환급 계산기"
  description="프리랜서 3.3% 원천징수 실수령액과 업종별 단순경비율·2026년 8단계 누진세율을 반영한 5월 종합소득세 예상 환급액·추가납부액을 원 단위로 정확하게 계산해보세요."
  canonicalPath="/freelancer-tax/"
  breadcrumbCategory="세무 · N잡"
  jsonLd={jsonLd}
>
  <div class="calc-header">
    <nav class="breadcrumb" aria-label="경로">
      <a href="/">얼마야</a>
      <span>/</span>
      <span>세무 · N잡</span>
    </nav>
    <h1>프리랜서 3.3% 실수령액 & 종합소득세 환급 계산기</h1>
    <p class="page-lead">
      연간 3.3% 사업소득의 예상 환급·추가납부 세액과 건별 원천징수 실수령액을 원 단위로 정확하게 계산합니다.
    </p>
  </div>

  <div class="calc-grid">
    <!-- Input Panel -->
    <section class="panel" aria-label="입력 조건">
      <div class="panel-title">
        <span>계산 조건 입력</span>
        <div class="segmented" style="width: 230px;" role="tablist" aria-label="계산 모드">
          <button type="button" class="seg-btn active" id="tab-annual" role="tab" aria-selected="true">연간 종소세</button>
          <button type="button" class="seg-btn" id="tab-single" role="tab" aria-selected="false">건별 3.3%</button>
        </div>
      </div>

      <!-- Mode 1: Annual -->
      <div id="mode-annual">
        <div class="field">
          <label class="field-label" for="annual-gross">
            <span>연간 총수입 (3.3% 공제 전 세전)</span>
            <span class="field-hint num" id="annual-gross-kor">3,600만원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="annual-gross" class="input-text has-unit num" value="36,000,000" />
            <span class="input-unit">원</span>
          </div>
          <div class="preset-row">
            <button type="button" class="preset-btn" data-target="annual-gross" data-val="20000000">2,000만</button>
            <button type="button" class="preset-btn" data-target="annual-gross" data-val="36000000">3,600만</button>
            <button type="button" class="preset-btn" data-target="annual-gross" data-val="50000000">5,000만</button>
            <button type="button" class="preset-btn" data-target="annual-gross" data-val="72000000">7,200만</button>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="job-type">
            <span>업종별 단순경비율 선택</span>
            <span class="field-hint">국세청 주요 인적용역 기준</span>
          </label>
          <select id="job-type" class="input-select">
            <option value="64.1" selected>IT·개발 / 작가·강사 / 디자인·마케팅 (64.1%)</option>
            <option value="79.4">배달라이더·대리운전·운송 (79.4%)</option>
            <option value="75.0">보험설계·방문판매·모집인 (75.0%)</option>
            <option value="61.7">학원강사·과외·교육서비스 (61.7%)</option>
            <option value="custom">경비율 직접 입력</option>
          </select>
        </div>

        <div class="field" id="custom-rate-wrap" style="display: none;">
          <label class="field-label" for="custom-rate">
            <span>직접 입력 경비율</span>
            <span class="field-hint">0 ~ 95%</span>
          </label>
          <div class="input-wrap">
            <input type="number" id="custom-rate" class="input-text has-unit num" value="64.1" min="0" max="95" step="0.1" />
            <span class="input-unit">%</span>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label class="field-label" for="dependents">
              <span>부양가족 수 (본인 포함)</span>
            </label>
            <div class="input-wrap">
              <input type="number" id="dependents" class="input-text has-unit num" value="1" min="1" max="10" step="1" />
              <span class="input-unit">명</span>
            </div>
          </div>

          <div class="field">
            <label class="field-label" for="extra-deduction">
              <span>기타 소득공제</span>
              <span class="field-hint num" id="extra-deduction-kor">0원</span>
            </label>
            <div class="input-wrap">
              <input type="text" inputmode="numeric" autocomplete="off" id="extra-deduction" class="input-text has-unit num" value="0" />
              <span class="input-unit">원</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Mode 2: Single payment -->
      <div id="mode-single" style="display: none;">
        <div class="field">
          <label class="field-label" for="single-amount">
            <span>계약(청구) 금액 (세전)</span>
            <span class="field-hint num" id="single-amount-kor">300만원</span>
          </label>
          <div class="input-wrap">
            <input type="text" inputmode="numeric" autocomplete="off" id="single-amount" class="input-text has-unit num" value="3,000,000" />
            <span class="input-unit">원</span>
          </div>
          <div class="preset-row">
            <button type="button" class="preset-btn" data-target="single-amount" data-val="500000">50만원</button>
            <button type="button" class="preset-btn" data-target="single-amount" data-val="1000000">100만원</button>
            <button type="button" class="preset-btn" data-target="single-amount" data-val="3000000">300만원</button>
            <button type="button" class="preset-btn" data-target="single-amount" data-val="5000000">500만원</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Result Panel -->
    <section class="panel panel-result" aria-live="polite" aria-label="계산 결과">
      <div class="panel-title">
        <span id="result-panel-heading">5월 종합소득세 예상 결과</span>
      </div>

      <div class="result-summary" id="result-box">
        <div class="result-label" id="result-status-label">예상 환급액 (돌려받는 금액)</div>
        <div class="result-figure num" id="result-main-figure">0원</div>
        <div class="result-sub" id="result-sub-text">미리 낸 3.3% 세금에서 결정세액을 뺀 예상 금액입니다.</div>
      </div>

      <table class="ledger" id="ledger-annual">
        <tbody>
          <tr>
            <th>연간 총수입 (세전)</th>
            <td id="r-gross">0원</td>
          </tr>
          <tr>
            <th>필요경비 (<span id="r-rate-label">64.1%</span>)</th>
            <td id="r-expense">0원</td>
          </tr>
          <tr>
            <th>종합소득금액</th>
            <td id="r-income">0원</td>
          </tr>
          <tr>
            <th>인적·기타 소득공제</th>
            <td id="r-deduction">0원</td>
          </tr>
          <tr>
            <th>과세표준 (적용세율 <span id="r-bracket">6%</span>)</th>
            <td id="r-taxbase">0원</td>
          </tr>
          <tr>
            <th>최종 결정세액 (지방소득세 포함)</th>
            <td id="r-decided" class="neg">0원</td>
          </tr>
          <tr>
            <th>기납부 3.3% 원천징수세액</th>
            <td id="r-withheld">0원</td>
          </tr>
          <tr class="total-row">
            <th id="r-final-label">예상 환급액</th>
            <td id="r-final" class="pos">0원</td>
          </tr>
        </tbody>
      </table>

      <table class="ledger" id="ledger-single" style="display: none;">
        <tbody>
          <tr>
            <th>계약(청구) 금액</th>
            <td id="s-gross">0원</td>
          </tr>
          <tr>
            <th>사업소득세 (3.0%)</th>
            <td id="s-income-tax" class="neg">0원</td>
          </tr>
          <tr>
            <th>지방소득세 (0.3%)</th>
            <td id="s-local-tax" class="neg">0원</td>
          </tr>
          <tr class="total-row">
            <th>실제 입금액 (96.7%)</th>
            <td id="s-net" class="pos">0원</td>
          </tr>
          <tr>
            <th>역산: 이 금액을 세후로 받으려면 청구액</th>
            <td id="s-reverse">0원</td>
          </tr>
        </tbody>
      </table>

      <div class="action-row">
        <button type="button" class="btn-secondary" id="btn-copy">결과 복사</button>
        <button type="button" class="btn-secondary" id="btn-reset">초기화</button>
      </div>
    </section>
  </div>

  <!-- Editorial SEO Guide & FAQ -->
  <article class="guide-section">
    <h2>프리랜서 3.3% 종합소득세 계산 원리 (2026년 기준)</h2>
    <p>
      프리랜서·N잡러가 용역 대금을 받을 때는 소득세 3%와 지방소득세 0.3%를 합친
      <strong>3.3%를 미리 떼고(원천징수)</strong> 입금받습니다. 이후 다음 해 5월 종합소득세 신고 기간에
      1년간 벌어들인 총수입에서 필요경비와 소득공제를 뺀 뒤 최종 세액을 확정해 차액을 정산합니다.
    </p>

    <h3>2026년 종합소득세 8단계 누진세율표</h3>
    <table class="info-table">
      <thead>
        <tr>
          <th>과세표준 구간</th>
          <th>세율</th>
          <th>누진공제액</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>1,400만 원 이하</td><td>6%</td><td>0원</td></tr>
        <tr><td>1,400만 원 초과 ~ 5,000만 원 이하</td><td>15%</td><td>126만 원</td></tr>
        <tr><td>5,000만 원 초과 ~ 8,800만 원 이하</td><td>24%</td><td>576만 원</td></tr>
        <tr><td>8,800만 원 초과 ~ 1억 5,000만 원 이하</td><td>35%</td><td>1,544만 원</td></tr>
        <tr><td>1억 5,000만 원 초과 ~ 3억 원 이하</td><td>38%</td><td>1,994만 원</td></tr>
        <tr><td>3억 원 초과 ~ 5억 원 이하</td><td>40%</td><td>2,594만 원</td></tr>
        <tr><td>5억 원 초과 ~ 10억 원 이하</td><td>42%</td><td>3,594만 원</td></tr>
        <tr><td>10억 원 초과</td><td>45%</td><td>6,594만 원</td></tr>
      </tbody>
    </table>

    <h3>계산 예시: 연 수입 3,600만 원 프리랜서 (단순경비율 64.1%, 1인 가구)</h3>
    <ol>
      <li><strong>기납부 3.3% 세액:</strong> 3,600만 원 × 3.3% = <strong>1,188,000원</strong></li>
      <li><strong>필요경비:</strong> 3,600만 원 × 64.1% = 23,076,000원 → 소득금액 12,924,000원</li>
      <li><strong>과세표준:</strong> 12,924,000원 − 본인 인적공제 1,500,000원 = 11,424,000원 (6% 구간)</li>
      <li><strong>최종 결정세액:</strong> (11,424,000 × 6% − 표준세액공제 70,000원) × 1.1(지방세 포함) ≈ <strong>676,984원</strong></li>
      <li><strong>예상 환급액:</strong> 1,188,000원 − 676,984원 ≈ <strong>약 51만 원 환급</strong></li>
    </ol>

    <h3>자주 묻는 질문 (FAQ)</h3>
    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>

    <div class="disclaimer-box">
      <strong>유의사항:</strong> 본 계산기는 단순경비율 단일 적용 및 표준세액공제(7만 원)를 기준으로 한
      참고용 시뮬레이션입니다. 연 수입 4,000만 원 초과 시 적용되는 초과율, 기준경비율 대상 여부,
      국민연금·건강보험료 납부액, 세액감면 등에 따라 실제 홈택스 신고 금액과 차이가 날 수 있습니다.
    </div>
  </article>

  <RelatedTools currentPath="/freelancer-tax/" />

  <script>
    import { bindWonInput, formatKoreanUnit, formatWon, parseWon, setWonInputValue } from '../lib/currency';

    function calcProgressiveTax(base: number): { tax: number; rate: number } {
      if (base <= 0) return { tax: 0, rate: 0 };
      if (base <= 14_000_000) return { tax: base * 0.06, rate: 6 };
      if (base <= 50_000_000) return { tax: base * 0.15 - 1_260_000, rate: 15 };
      if (base <= 88_000_000) return { tax: base * 0.24 - 5_760_000, rate: 24 };
      if (base <= 150_000_000) return { tax: base * 0.35 - 15_440_000, rate: 35 };
      if (base <= 300_000_000) return { tax: base * 0.38 - 19_940_000, rate: 38 };
      if (base <= 500_000_000) return { tax: base * 0.40 - 25_940_000, rate: 40 };
      if (base <= 1_000_000_000) return { tax: base * 0.42 - 35_940_000, rate: 42 };
      return { tax: base * 0.45 - 65_940_000, rate: 45 };
    }

    let currentMode: 'annual' | 'single' = 'annual';

    const tabAnnual = document.getElementById('tab-annual') as HTMLButtonElement;
    const tabSingle = document.getElementById('tab-single') as HTMLButtonElement;
    const modeAnnual = document.getElementById('mode-annual') as HTMLElement;
    const modeSingle = document.getElementById('mode-single') as HTMLElement;
    const ledgerAnnual = document.getElementById('ledger-annual') as HTMLElement;
    const ledgerSingle = document.getElementById('ledger-single') as HTMLElement;
    const panelHeading = document.getElementById('result-panel-heading') as HTMLElement;

    const grossInput = document.getElementById('annual-gross') as HTMLInputElement;
    const grossHint = document.getElementById('annual-gross-kor') as HTMLElement;
    const jobSelect = document.getElementById('job-type') as HTMLSelectElement;
    const customRateWrap = document.getElementById('custom-rate-wrap') as HTMLElement;
    const customRateInput = document.getElementById('custom-rate') as HTMLInputElement;
    const depInput = document.getElementById('dependents') as HTMLInputElement;
    const extraInput = document.getElementById('extra-deduction') as HTMLInputElement;
    const extraHint = document.getElementById('extra-deduction-kor') as HTMLElement;
    const singleInput = document.getElementById('single-amount') as HTMLInputElement;
    const singleHint = document.getElementById('single-amount-kor') as HTMLElement;

    const resultBox = document.getElementById('result-box') as HTMLElement;
    const statusLabel = document.getElementById('result-status-label') as HTMLElement;
    const mainFigure = document.getElementById('result-main-figure') as HTMLElement;
    const subText = document.getElementById('result-sub-text') as HTMLElement;

    let lastSummaryText = '';

    function update() {
      if (currentMode === 'annual') {
        const gross = parseWon(grossInput.value);
        grossHint.textContent = formatKoreanUnit(gross);

        const rate =
          jobSelect.value === 'custom'
            ? Math.min(95, Math.max(0, Number(customRateInput.value) || 0))
            : Number(jobSelect.value);

        const dependents = Math.max(1, Math.floor(Number(depInput.value) || 1));
        const extraWon = parseWon(extraInput.value);
        extraHint.textContent = formatKoreanUnit(extraWon);

        const expenses = Math.round(gross * (rate / 100));
        const income = Math.max(0, gross - expenses);
        const deductions = dependents * 1_500_000 + extraWon;
        const taxBase = Math.max(0, income - deductions);

        const { tax: rawTax, rate: bracket } = calcProgressiveTax(taxBase);
        const decidedIncomeTax = Math.max(0, Math.round(rawTax) - 70_000);
        const decidedLocalTax = Math.round(decidedIncomeTax * 0.1);
        const totalDecided = decidedIncomeTax + decidedLocalTax;

        const withheld = Math.round(gross * 0.033);
        const diff = withheld - totalDecided;

        (document.getElementById('r-gross') as HTMLElement).textContent = formatWon(gross);
        (document.getElementById('r-rate-label') as HTMLElement).textContent = `${rate.toFixed(1)}%`;
        (document.getElementById('r-expense') as HTMLElement).textContent = `- ${formatWon(expenses)}`;
        (document.getElementById('r-income') as HTMLElement).textContent = formatWon(income);
        (document.getElementById('r-deduction') as HTMLElement).textContent = `- ${formatWon(deductions)}`;
        (document.getElementById('r-bracket') as HTMLElement).textContent = `${bracket}%`;
        (document.getElementById('r-taxbase') as HTMLElement).textContent = formatWon(taxBase);
        (document.getElementById('r-decided') as HTMLElement).textContent = formatWon(totalDecided);
        (document.getElementById('r-withheld') as HTMLElement).textContent = formatWon(withheld);

        const finalLabel = document.getElementById('r-final-label') as HTMLElement;
        const finalVal = document.getElementById('r-final') as HTMLElement;

        resultBox.classList.remove('is-warning', 'is-danger');
        if (diff >= 0) {
          statusLabel.textContent = '예상 환급액 (돌려받는 금액)';
          mainFigure.textContent = `+ ${formatWon(diff)}`;
          subText.textContent = '미리 낸 3.3% 세금이 결정세액보다 많아 환급이 예상됩니다.';
          finalLabel.textContent = '예상 환급액';
          finalVal.textContent = `+ ${formatWon(diff)}`;
          finalVal.className = 'pos';
          lastSummaryText = `[얼마야] 프리랜서 3.3% 종소세 예상\n- 연 총수입: ${formatWon(gross)} (경비율 ${rate}%)\n- 기납부 3.3%: ${formatWon(withheld)}\n- 결정세액: ${formatWon(totalDecided)}\n- 예상 환급액: +${formatWon(diff)}`;
        } else {
          resultBox.classList.add('is-danger');
          statusLabel.textContent = '예상 추가납부액 (더 내야 할 금액)';
          mainFigure.textContent = formatWon(Math.abs(diff));
          subText.textContent = '결정세액이 기납부 3.3%보다 크므로 5월 신고 시 추가 납부가 예상됩니다.';
          finalLabel.textContent = '예상 추가납부액';
          finalVal.textContent = `- ${formatWon(Math.abs(diff))}`;
          finalVal.className = 'neg';
          lastSummaryText = `[얼마야] 프리랜서 3.3% 종소세 예상\n- 연 총수입: ${formatWon(gross)} (경비율 ${rate}%)\n- 기납부 3.3%: ${formatWon(withheld)}\n- 결정세액: ${formatWon(totalDecided)}\n- 예상 추가납부액: ${formatWon(Math.abs(diff))}`;
        }
      } else {
        const gross = parseWon(singleInput.value);
        singleHint.textContent = formatKoreanUnit(gross);

        const incomeTax = Math.round(gross * 0.03);
        const localTax = Math.round(gross * 0.003);
        const net = gross - incomeTax - localTax;
        const reverseGross = Math.round(gross / 0.967);

        resultBox.classList.remove('is-warning', 'is-danger');
        statusLabel.textContent = '실제 입금받는 금액 (3.3% 공제 후)';
        mainFigure.textContent = formatWon(net);
        subText.textContent = `총 원천징수 세액은 ${formatWon(incomeTax + localTax)}입니다.`;

        (document.getElementById('s-gross') as HTMLElement).textContent = formatWon(gross);
        (document.getElementById('s-income-tax') as HTMLElement).textContent = `- ${formatWon(incomeTax)}`;
        (document.getElementById('s-local-tax') as HTMLElement).textContent = `- ${formatWon(localTax)}`;
        (document.getElementById('s-net') as HTMLElement).textContent = formatWon(net);
        (document.getElementById('s-reverse') as HTMLElement).textContent = formatWon(reverseGross);

        lastSummaryText = `[얼마야] 건별 3.3% 실수령액\n- 계약금액: ${formatWon(gross)}\n- 3.3% 공제: ${formatWon(incomeTax + localTax)}\n- 실수령액: ${formatWon(net)}`;
      }
    }

    function setMode(mode: 'annual' | 'single') {
      currentMode = mode;
      tabAnnual.classList.toggle('active', mode === 'annual');
      tabSingle.classList.toggle('active', mode === 'single');
      tabAnnual.setAttribute('aria-selected', String(mode === 'annual'));
      tabSingle.setAttribute('aria-selected', String(mode === 'single'));
      modeAnnual.style.display = mode === 'annual' ? '' : 'none';
      modeSingle.style.display = mode === 'single' ? '' : 'none';
      ledgerAnnual.style.display = mode === 'annual' ? '' : 'none';
      ledgerSingle.style.display = mode === 'single' ? '' : 'none';
      panelHeading.textContent = mode === 'annual' ? '5월 종합소득세 예상 결과' : '건별 3.3% 실수령액 결과';
      update();
    }

    bindWonInput(grossInput, update, grossHint);
    bindWonInput(extraInput, update, extraHint);
    bindWonInput(singleInput, update, singleHint);

    tabAnnual.addEventListener('click', () => setMode('annual'));
    tabSingle.addEventListener('click', () => setMode('single'));

    jobSelect.addEventListener('change', () => {
      customRateWrap.style.display = jobSelect.value === 'custom' ? '' : 'none';
      update();
    });

    [customRateInput, depInput].forEach((el) => el.addEventListener('input', update));

    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target || '') as HTMLInputElement | null;
        if (target && btn.dataset.val) {
          setWonInputValue(target, Number(btn.dataset.val));
          update();
        }
      });
    });

    const btnCopy = document.getElementById('btn-copy') as HTMLButtonElement;
    btnCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastSummaryText);
        btnCopy.textContent = '복사 완료!';
        setTimeout(() => (btnCopy.textContent = '결과 복사'), 1500);
      } catch {
        btnCopy.textContent = '복사 실패';
        setTimeout(() => (btnCopy.textContent = '결과 복사'), 1500);
      }
    });

    const btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
    btnReset.addEventListener('click', () => {
      setWonInputValue(grossInput, 0);
      jobSelect.value = '64.1';
      customRateWrap.style.display = 'none';
      customRateInput.value = '64.1';
      depInput.value = '1';
      setWonInputValue(extraInput, 0);
      setWonInputValue(singleInput, 0);
      update();
      btnReset.textContent = '초기화 완료';
      setTimeout(() => (btnReset.textContent = '초기화'), 1200);
    });

    update();
  </script>
</BaseLayout>
