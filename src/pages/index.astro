---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '얼마야',
  url: 'https://howmuch.jokerx04.com/',
  description:
    '직장인·프리랜서·N잡러를 위한 실전 금융·세무 계산기 8종 모음. 연말정산 환급·절세, 프리랜서 3.3% 환급, 직장인 N잡 합산 종소세, 간이vs일반 부가세, 퇴사 총수령액, 이직 연봉 실수령 비교, 전세 vs 월세 손익 비교, 대출 이자 상환방식 비교를 무료로 계산합니다.',
};

const tools = [
  {
    href: '/year-end-tax/',
    group: 'tax',
    category: '세무 · N잡',
    title: '연말정산 환급·절세 시뮬레이터 (카드 25% · 연금저축/IRP · 월세)',
    description:
      '총급여 25% 카드 공제 황금비율, 연금저축·IRP 최대 900만 원 세액공제, 월세 세액공제까지 3대 핵심 절세 금액과 연말까지 남은 추가 환급 여력을 한 번에 계산합니다.',
    tags: ['신용·체크카드 25%', '연금저축·IRP', '월세 세액공제', '연말 추가 절세'],
  },
  {
    href: '/freelancer-tax/',
    group: 'tax',
    category: '세무 · N잡',
    title: '프리랜서 3.3% 실수령액 & 종합소득세 환급 계산기',
    description:
      '건별·월별 3.3% 원천징수 실수령액과 업종별 단순경비율·2026년 8단계 누진세율을 반영한 5월 종소세 환급액 또는 추가납부액을 미리 확인합니다.',
    tags: ['3.3% 원천징수', '단순경비율', '종소세 환급', '역산 청구액'],
  },
  {
    href: '/njob-tax/',
    group: 'tax',
    category: '세무 · N잡',
    title: '직장인 + 부업(N잡) 합산 종합소득세 시뮬레이터',
    description:
      '본업 연봉에 블로그·애드센스·스마트스토어·프리랜서 부업 수익이 합산될 때 5월 추가 납부 세액과 건보료 2,000만 원 초과 여부를 즉시 계산합니다.',
    tags: ['근로+사업 합산', '추가 세율 구간', '건보료 2,000만 기준', '부업 순수익'],
  },
  {
    href: '/vat-compare/',
    group: 'tax',
    category: '세무 · N잡',
    title: '간이과세자 vs 일반과세자 부가가치세 비교기',
    description:
      '연간 매출·매입액과 업종별 부가가치율에 따라 간이과세 납부면제(4,800만 미만)와 일반과세 매입 환급 중 어느 쪽이 유리한지 판정합니다.',
    tags: ['간이과세 납부면제', '일반과세 환급', '업종별 부가가치율', '1인 사업자'],
  },
  {
    href: '/severance-total/',
    group: 'career',
    category: '퇴사 · 급여',
    title: '퇴사 시 총 수령액 통합 계산기 (퇴직금 + 연차수당 + 실업급여)',
    description:
      '입사일·퇴사일과 급여만 입력하면 퇴직금, 미사용 연차수당, 실업급여(120~270일)를 한 화면에서 합산해 퇴사 후 자금 계획을 세울 수 있습니다.',
    tags: ['퇴직금 계산', '미사용 연차수당', '실업급여 일수', '비자발적 퇴사'],
  },
  {
    href: '/salary-compare/',
    group: 'career',
    category: '퇴사 · 급여',
    title: '이직 연봉 협상 월 실수령액 비교기',
    description:
      '현재 연봉과 이직 제안 연봉을 나란히 놓고 4대보험과 소득세 구간 변화를 반영한 진짜 월 실수령액 증가분과 연 세후 차이를 비교합니다.',
    tags: ['이직 연봉 협상', '4대보험 공제', '월 실수령 차이', '+10~30% 시뮬레이션'],
  },
  {
    href: '/jeonse-vs-wolse/',
    group: 'housing',
    category: '주거 · 대출',
    title: '전세 vs 월세 진짜 손익 비교기',
    description:
      '전세대출 이자, 보유 현금의 예금·투자 기회비용, 관리비까지 모두 합산해 실질 월 주거비와 손익분기 월세를 정확히 비교합니다.',
    tags: ['전세대출 이자', '보증금 기회비용', '실질 월 주거비', '손익분기 월세'],
  },
  {
    href: '/loan-calc/',
    group: 'housing',
    category: '주거 · 대출',
    title: '대출 이자 · 상환방식 비교 계산기 (원리금균등·원금균등·만기일시)',
    description:
      '주택담보대출·전세대출·신용대출의 원리금균등, 원금균등, 만기일시 3가지 상환방식 월 납입액과 총 이자 차이를 한 화면에서 비교합니다.',
    tags: ['원리금균등', '원금균등', '만기일시', '거치기간 이자'],
  },
];

---

<BaseLayout
  title="얼마야"
  description="연말정산 환급·절세, 프리랜서 3.3% 환급, 직장인 N잡 합산 종소세, 간이vs일반 부가세, 퇴사 총수령액, 이직 연봉 실수령 비교, 전세 vs 월세, 대출 이자 비교까지 무료 실전 금융·세무 계산기 8종."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="home-hero">
    <h1>복잡한 세금과 돈 계산, 한 화면에서 바로 확인하세요</h1>
    <p class="page-lead">
      직장인·프리랜서·N잡러가 가장 자주 찾는 세무·급여·주거·대출 계산기 8종을 한곳에 모았습니다.
      회원가입 없이 브라우저에서 즉시 계산되며 입력값은 서버에 저장되지 않습니다.
    </p>
    <div class="hero-meta">
      <span class="meta-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        입력값 서버 저장 없음
      </span>
      <span class="meta-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 6v6l4 2" />
        </svg>
        2026년 세율·요율 반영
      </span>
      <span class="meta-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
          <polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        핵심 계산기 8종 무료
      </span>
    </div>
  </section>

  <div class="preset-row" style="margin-bottom: 20px;" role="tablist" aria-label="카테고리 필터">
    <button type="button" class="preset-btn filter-btn active-filter" data-filter="all">전체 (8)</button>
    <button type="button" class="preset-btn filter-btn" data-filter="tax">세무 · N잡 (4)</button>
    <button type="button" class="preset-btn filter-btn" data-filter="career">퇴사 · 급여 (2)</button>
    <button type="button" class="preset-btn filter-btn" data-filter="housing">주거 · 대출 (2)</button>
  </div>

  <section aria-label="핵심 금융 세무 계산기 목록">
    <div class="tool-list" id="tool-list">
      {tools.map((tool) => (
        <a href={tool.href} class="tool-row" data-group={tool.group}>
          <div>
            <span class="tool-cat">{tool.category}</span>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <div class="tool-tags">
              {tool.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          </div>
          <span class="tool-cta">
            계산하기
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="upcoming-section" aria-label="실전 금융 세무 가이드">
    <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
      <h2>실전 금융·세무 가이드</h2>
      <a href="/guide/" style="font-size: 0.88rem; font-weight: 700; color: var(--brand-ink);">전체 가이드 보기 →</a>
    </div>
    <div class="upcoming-grid">
      <a href="/guide/year-end-tax-card-25/" class="upcoming-item">
        <strong>2026 연말정산 신용카드 25% 황금비율</strong>
        <span>체크카드 전환 시점과 연금저축·IRP 900만 원 전략</span>
      </a>
      <a href="/guide/njob-health-insurance-2000/" class="upcoming-item">
        <strong>직장인 N잡 건보료 2,000만 원 기준</strong>
        <span>매출과 소득금액 차이 및 5월 종소세 절세법</span>
      </a>
      <a href="/guide/jeonse-vs-wolse-checklist/" class="upcoming-item">
        <strong>전세 vs 월세 기회비용·손익분기 월세</strong>
        <span>계약 전 금리·보증금으로 진짜 손익 따지기</span>
      </a>
      <a href="/guide/severance-unemployment-tips/" class="upcoming-item">
        <strong>퇴사 전 퇴직금·연차·실업급여 체크</strong>
        <span>퇴사일 하루 차이로 수령액 손해 안 보는 법</span>
      </a>
    </div>
  </section>

  <style>
    .filter-btn {
      padding: 7px 14px;
      font-size: 0.86rem;
    }
    .filter-btn.active-filter {
      background: var(--brand);
      border-color: var(--brand);
      color: #ffffff;
    }
  </style>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const rows = document.querySelectorAll<HTMLElement>('.tool-row');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';
        buttons.forEach((b) => b.classList.toggle('active-filter', b === btn));
        rows.forEach((row) => {
          row.style.display = filter === 'all' || row.dataset.group === filter ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
