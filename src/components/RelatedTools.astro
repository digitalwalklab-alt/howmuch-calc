---
interface ToolItem {
  href: string;
  category: string;
  title: string;
  desc: string;
}

interface GuideItem {
  href: string;
  title: string;
  forPaths: string[];
}

interface Props {
  currentPath: string;
  showGuide?: boolean;
}

const { currentPath, showGuide = true } = Astro.props;

const allTools: ToolItem[] = [
  {
    href: '/year-end-tax/',
    category: '세무 · N잡',
    title: '연말정산 환급·절세 시뮬레이터',
    desc: '카드 25% · 연금저축/IRP · 월세 세액공제 통합',
  },
  {
    href: '/freelancer-tax/',
    category: '세무 · N잡',
    title: '프리랜서 3.3% 종소세 환급 계산기',
    desc: '단순경비율 · 8단계 누진세율 · 건별 역산',
  },
  {
    href: '/njob-tax/',
    category: '세무 · N잡',
    title: '직장인 + 부업(N잡) 합산 종소세',
    desc: '근로+사업 합산 세율 · 건보료 2,000만 기준',
  },
  {
    href: '/vat-compare/',
    category: '세무 · N잡',
    title: '간이과세자 vs 일반과세자 부가세',
    desc: '4,800만 납부면제 · 매입 환급 유불리 판정',
  },
  {
    href: '/severance-total/',
    category: '퇴사 · 급여',
    title: '퇴사 시 총 수령액 통합 계산기',
    desc: '퇴직금 + 미사용 연차수당 + 실업급여 합산',
  },
  {
    href: '/salary-compare/',
    category: '퇴사 · 급여',
    title: '이직 연봉 협상 월 실수령액 비교기',
    desc: '현재 vs 제안 연봉 4대보험·세후 월급 차이',
  },
  {
    href: '/jeonse-vs-wolse/',
    category: '주거 · 대출',
    title: '전세 vs 월세 진짜 손익 비교기',
    desc: '대출이자 · 보증금 기회비용 · 손익분기 월세',
  },
  {
    href: '/loan-calc/',
    category: '주거 · 대출',
    title: '대출 이자 · 상환방식 비교 계산기',
    desc: '원리금균등 vs 원금균등 vs 만기일시 총이자 비교',
  },
];

const guides: GuideItem[] = [
  {
    href: '/guide/year-end-tax-card-25/',
    title: '2026 연말정산 신용카드 25% 황금비율 & 체크카드 전환 시점 총정리',
    forPaths: ['/year-end-tax'],
  },
  {
    href: '/guide/njob-health-insurance-2000/',
    title: '직장인 부업(N잡) 건강보험료 2,000만 원 기준과 5월 종소세 절세 전략',
    forPaths: ['/njob-tax', '/freelancer-tax', '/vat-compare'],
  },
  {
    href: '/guide/jeonse-vs-wolse-checklist/',
    title: '전세 vs 월세 결정 전 꼭 따져야 할 기회비용·손익분기 월세 계산법',
    forPaths: ['/jeonse-vs-wolse', '/loan-calc'],
  },
  {
    href: '/guide/severance-unemployment-tips/',
    title: '퇴사 전 반드시 챙겨야 할 퇴직금·미사용 연차수당·실업급여 체크리스트',
    forPaths: ['/severance-total', '/salary-compare'],
  },
];

const normCurrent = currentPath.replace(/\/$/, '') || '/';
const related = allTools.filter((t) => t.href.replace(/\/$/, '') !== normCurrent).slice(0, 3);
const matchedGuide = guides.find((g) => g.forPaths.includes(normCurrent));
---

{showGuide && matchedGuide && (
  <section class="related-section" style="margin-top: 36px; padding-top: 24px;" aria-label="관련 실전 가이드">
    <a href={matchedGuide.href} class="related-card" style="background: var(--surface-tint); border-color: #cce7e4;">
      <span class="related-cat">관련 실전 가이드</span>
      <strong>{matchedGuide.title}</strong>
      <span style="color: var(--brand-ink); font-weight: 600;">가이드 전체 읽기 →</span>
    </a>
  </section>
)}

<section class="related-section" aria-label="관련 계산기">
  <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px;">
    <h2>함께 보면 좋은 계산기</h2>
    <a href="/guide/" style="font-size: 0.86rem; font-weight: 700; color: var(--brand-ink);">실전 가이드 전체 보기 →</a>
  </div>
  <div class="related-grid">
    {related.map((item) => (
      <a href={item.href} class="related-card">
        <span class="related-cat">{item.category}</span>
        <strong>{item.title}</strong>
        <span>{item.desc}</span>
      </a>
    ))}
  </div>
</section>
