---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbCategory?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  jsonLd,
  breadcrumbCategory,
} = Astro.props;

const siteOrigin = (Astro.site ?? new URL('https://howmuch.jokerx04.com')).toString().replace(/\/$/, '');
const siteName = '얼마야';
const fullTitle = title === siteName ? `${siteName} — 직장인·N잡러 실전 금융·세무 계산기` : `${title} | ${siteName}`;
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const breadcrumbLd = breadcrumbCategory
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: siteName, item: `${siteOrigin}/` },
        { '@type': 'ListItem', position: 2, name: title, item: canonicalUrl },
      ],
    }
  : null;

const combinedJsonLd = [
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
  ...(breadcrumbLd ? [breadcrumbLd] : []),
];

const navItems = [
  { href: '/', label: '전체' },
  { href: '/year-end-tax/', label: '연말정산' },
  { href: '/freelancer-tax/', label: '프리랜서 3.3%' },
  { href: '/njob-tax/', label: '직장인 N잡' },
  { href: '/vat-compare/', label: '간이vs일반' },
  { href: '/severance-total/', label: '퇴사 총수령액' },
  { href: '/salary-compare/', label: '이직 연봉' },
  { href: '/jeonse-vs-wolse/', label: '전세vs월세' },
  { href: '/loan-calc/', label: '대출 이자' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0F766E" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteOrigin}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteOrigin}/og-image.png`} />

    <!-- Pretendard Variable Font -->
    <link
      rel="stylesheet"
      as="style"
      crossorigin
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    {combinedJsonLd.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(combinedJsonLd.length === 1 ? combinedJsonLd[0] : combinedJsonLd)} />
    )}

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HT6SYN20JX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-HT6SYN20JX');
    </script>

    <!-- Google AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1437145358254272"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-link" aria-label="얼마야 홈">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#0F766E" />
            <rect x="7" y="7" width="18" height="5" rx="1.5" fill="#F0FDFA" />
            <rect x="7" y="15" width="4.5" height="4" rx="1" fill="#99F6E4" />
            <rect x="13.75" y="15" width="4.5" height="4" rx="1" fill="#99F6E4" />
            <rect x="20.5" y="15" width="4.5" height="10" rx="1" fill="#FDE68A" />
            <rect x="7" y="21" width="4.5" height="4" rx="1" fill="#99F6E4" />
            <rect x="13.75" y="21" width="4.5" height="4" rx="1" fill="#99F6E4" />
          </svg>
          <span>얼마야</span>
        </a>
        <div class="nav-shell" id="nav-shell">
          <nav class="site-nav" id="site-nav" aria-label="주요 계산기">
            {navItems.map((item) => {
              const normHref = item.href.replace(/\/$/, '') || '/';
              const isActive = currentPath === normHref;
              return (
                <a
                  href={item.href}
                  class:list={['nav-link', { active: isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                  draggable="false"
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
          <div class="nav-indicator" id="nav-indicator" aria-hidden="true">
            <div class="nav-indicator-thumb" id="nav-indicator-thumb"></div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>얼마야</strong> · 모든 계산은 브라우저에서 즉시 처리되며 입력값은 서버에 저장되지 않습니다.
        </div>
        <div class="footer-links">
          <a href="/about/">사이트 소개</a>
          <a href="/privacy/">개인정보처리방침</a>
        </div>
      </div>
    </footer>

    <script>
      // Auto-select numeric input contents on initial focus so typing replaces '0' cleanly
      document.querySelectorAll<HTMLInputElement>('input[type="number"], input[inputmode="numeric"]').forEach((el) => {
        let justFocused = false;
        el.addEventListener('focus', () => {
          justFocused = true;
          try {
            el.select();
          } catch {
            // Ignore on unsupported browsers
          }
        });
        el.addEventListener('mouseup', (e) => {
          if (justFocused) {
            e.preventDefault();
            justFocused = false;
          }
        });
      });

      // Horizontal slide navigation (touch swipe + mouse drag + wheel + edge fades + 3px indicator + active tab centering)
      const navShell = document.getElementById('nav-shell');
      const nav = document.getElementById('site-nav');
      const navThumb = document.getElementById('nav-indicator-thumb');

      if (navShell && nav) {
        const updateFade = () => {
          const maxScroll = nav.scrollWidth - nav.clientWidth;
          const canScroll = maxScroll > 4;
          navShell.classList.toggle('is-scrollable', canScroll);
          navShell.classList.toggle('fade-left', canScroll && nav.scrollLeft > 4);
          navShell.classList.toggle('fade-right', canScroll && nav.scrollLeft < maxScroll - 4);

          if (navThumb && canScroll) {
            const visibleRatio = Math.min(1, nav.clientWidth / nav.scrollWidth);
            const thumbPct = Math.max(18, visibleRatio * 100);
            const scrollRatio = maxScroll > 0 ? nav.scrollLeft / maxScroll : 0;
            const maxOffsetPct = 100 - thumbPct;
            navThumb.style.width = `${thumbPct.toFixed(1)}%`;
            navThumb.style.left = `${(scrollRatio * maxOffsetPct).toFixed(1)}%`;
          }
        };

        // Mouse drag-to-slide
        let isPointerDown = false;
        let hasDragged = false;
        let startX = 0;
        let startScrollLeft = 0;

        nav.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse' || e.button !== 0) return;
          if (nav.scrollWidth <= nav.clientWidth) return;
          isPointerDown = true;
          hasDragged = false;
          startX = e.clientX;
          startScrollLeft = nav.scrollLeft;
          nav.classList.add('is-dragging');
        });

        window.addEventListener('pointermove', (e) => {
          if (!isPointerDown) return;
          const dx = e.clientX - startX;
          if (Math.abs(dx) > 5) {
            hasDragged = true;
          }
          if (hasDragged) {
            nav.scrollLeft = startScrollLeft - dx;
          }
        });

        const endDrag = () => {
          if (!isPointerDown) return;
          isPointerDown = false;
          nav.classList.remove('is-dragging');
          if (hasDragged) {
            setTimeout(() => {
              hasDragged = false;
            }, 0);
          }
        };

        window.addEventListener('pointerup', endDrag);
        window.addEventListener('pointercancel', endDrag);

        nav.addEventListener(
          'click',
          (e) => {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
            }
          },
          true
        );

        nav.addEventListener(
          'wheel',
          (e) => {
            if (nav.scrollWidth > nav.clientWidth && Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
              e.preventDefault();
              nav.scrollLeft += e.deltaY;
            }
          },
          { passive: false }
        );

        nav.addEventListener('scroll', updateFade, { passive: true });
        window.addEventListener('resize', updateFade);

        const activeLink = nav.querySelector<HTMLElement>('.nav-link.active');
        if (activeLink && nav.scrollWidth > nav.clientWidth) {
          activeLink.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'instant' as ScrollBehavior });
        }
        updateFade();
      }
    </script>
  </body>
</html>
